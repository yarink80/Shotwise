<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hotkeys, single instance/IPC, autostart, file/URI association, toasts, updater, mobile connect server, policy. Owner: WP-PLATFORM. -->
  <PropertyGroup>
    <TargetFramework>$(ShotwiseTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotwiseSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Shotwise.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shotwise.Core\Shotwise.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pwa\*" />
    <!-- Tests moved to tests/Shotwise.Platform.Tests (CONTRACT A14); keep any stale build artefacts out of this project. -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

</Project>
