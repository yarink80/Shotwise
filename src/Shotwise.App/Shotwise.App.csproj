<Project Sdk="Microsoft.NET.Sdk">

  <!-- Composition root: Generic Host, App.xaml, tray icon, startup, command line. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ShotwiseTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotwiseSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Shotwise.App</RootNamespace>
    <AssemblyName>Shotwise</AssemblyName>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Original Shotwise app icon (tools/icon-gen): exe, taskbar, Alt+Tab, Start menu shortcut and the .shotx DefaultIcon. -->
    <ApplicationIcon>Assets\shotwise.ico</ApplicationIcon>
    <StartupObject>Shotwise.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Installer/updater hooks (Hosting/InstallHooks.cs); packaging in tools/package.ps1. -->
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shotwise.Core\Shotwise.Core.csproj" />
    <ProjectReference Include="..\Shotwise.Editor\Shotwise.Editor.csproj" />
    <ProjectReference Include="..\Shotwise.Rendering\Shotwise.Rendering.csproj" />
    <ProjectReference Include="..\Shotwise.Capture\Shotwise.Capture.csproj" />
    <ProjectReference Include="..\Shotwise.Recording\Shotwise.Recording.csproj" />
    <ProjectReference Include="..\Shotwise.Media\Shotwise.Media.csproj" />
    <ProjectReference Include="..\Shotwise.Vision\Shotwise.Vision.csproj" />
    <ProjectReference Include="..\Shotwise.Library\Shotwise.Library.csproj" />
    <ProjectReference Include="..\Shotwise.Sharing\Shotwise.Sharing.csproj" />
    <ProjectReference Include="..\Shotwise.Platform\Shotwise.Platform.csproj" />
    <ProjectReference Include="..\Shotwise.UI.Common\Shotwise.UI.Common.csproj" />
    <ProjectReference Include="..\Shotwise.UI.Capture\Shotwise.UI.Capture.csproj" />
    <ProjectReference Include="..\Shotwise.UI.Dialogs\Shotwise.UI.Dialogs.csproj" />
    <ProjectReference Include="..\Shotwise.UI.Editor\Shotwise.UI.Editor.csproj" />
  </ItemGroup>

  <!-- Custom Main (Program.cs) builds the host first: App.xaml is compiled as a Page so WPF does not generate its own Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- tools/package.ps1 publishes ReadyToRun. These large assemblies are only partly used (WinRT projection, GL bindings, SSH/S-MIME
       crypto): precompiling them would double their size (~45 MB installed) for little startup gain, so they stay IL + JIT. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll;OpenTK.Graphics.dll;BouncyCastle.Cryptography.dll" />
  </ItemGroup>

  <!-- Built-in content (stamps, templates, themes, palettes, cursors) authored by WP-UI-DIALOGS / WP-LIBRARY. -->
  <ItemGroup>
    <None Update="Content\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Toast app logo (file URI) and the master artwork next to the exe. -->
    <None Update="Assets\png\shotwise-96.png" Link="Assets\shotwise-96.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\shotwise-icon.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
