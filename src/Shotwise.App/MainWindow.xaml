<ui:FluentWindow x:Class="Shotwise.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:res="clr-namespace:Shotwise.UI.Common.Resources;assembly=Shotwise.UI.Common"
                 Title="{x:Static res:Strings.MainWindow_Title}"
                 Width="560" Height="340" MinWidth="420" MinHeight="260"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <!-- Placeholder main window (WP-FOUNDATION). The real editor window is provided by UI.Editor via IEditorHost. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.MainWindow_Title}" />
        <StackPanel Grid.Row="1" Margin="24" VerticalAlignment="Center">
            <TextBlock Text="&#xE722;" FontFamily="{StaticResource Shotwise.IconFont}" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{x:Static res:Strings.App_Name}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.App_Tagline}" Margin="0,4,0,16" HorizontalAlignment="Center" Opacity="0.8" />
            <TextBlock Text="{x:Static res:Strings.MainWindow_Placeholder}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <ui:Button x:Name="CaptureButton" Content="{x:Static res:Strings.Tray_Capture}" Appearance="Primary" Margin="0,0,8,0" Click="OnCapture" />
                <ui:Button Content="{x:Static res:Strings.Tray_Exit}" Click="OnExit" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
