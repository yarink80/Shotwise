<Project Sdk="Microsoft.NET.Sdk">

  <!-- SQLite catalog, autosave, file watcher, tags, backup/restore, share history, styles/stamps/templates catalogs. Owner: WP-LIBRARY. -->
  <PropertyGroup>
    <TargetFramework>$(ShotwiseTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotwiseSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Shotwise.Library</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shotwise.Core\Shotwise.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shotwise.Library.Tests" />
  </ItemGroup>

</Project>
