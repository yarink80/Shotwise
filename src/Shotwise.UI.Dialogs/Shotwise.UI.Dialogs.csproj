<Project Sdk="Microsoft.NET.Sdk">

  <!-- All editor modal dialogs, preferences shell, IShareUi implementation, built-in content authoring. Owner: WP-UI-DIALOGS. -->
  <PropertyGroup>
    <TargetFramework>$(ShotwiseTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotwiseSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Shotwise.UI.Dialogs</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shotwise.Core\Shotwise.Core.csproj" />
    <ProjectReference Include="..\Shotwise.UI.Common\Shotwise.UI.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ShotwiseContentTool)' == 'true'">
    <OutputType>Exe</OutputType>
    <StartupObject>Shotwise.UI.Dialogs.Tools.ContentTool</StartupObject>
  </PropertyGroup>
  <ItemGroup Condition="'$(ShotwiseContentTool)' == 'true'">
    <Compile Include="Tools\ContentTool.cs" /><Compile Include="Tools\UiSmoke.cs" /><Compile Include="Tools\DialogSmoke.cs" /><Compile Include="Tools\DialogShots.cs" />
  </ItemGroup>
</Project>



