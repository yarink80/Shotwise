<!-- Shotwise component styles (docs/DESIGN-SYSTEM.md section 4). Theme-aware through {DynamicResource Shotwise.*} tokens.
     Keyed styles for standard controls (Shotwise.PrimaryButton, ...) + default (implicit) styles for Shotwise custom controls.
     No implicit styles for built-in WPF types: screens opt in explicitly. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sw="clr-namespace:Shotwise.UI.Common.Controls">

    <!-- ===================================================================== Focus visuals -->
    <Style x:Key="Shotwise.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Shotwise.AccentBrush}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shotwise.FocusVisual.Round">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="-3" Stroke="{DynamicResource Shotwise.AccentBrush}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Typography -->
    <Style x:Key="Shotwise.Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Shotwise.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Shotwise.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily.Display}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Shotwise.Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Shotwise.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Shotwise.Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}" />
    <Style x:Key="Shotwise.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
    </Style>
    <Style x:Key="Shotwise.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
    </Style>
    <Style x:Key="Shotwise.Text.Overline" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextTertiaryBrush}" />
    </Style>
    <Style x:Key="Shotwise.Text.Accent" TargetType="TextBlock" BasedOn="{StaticResource Shotwise.Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===================================================================== Surfaces / bars / dividers -->
    <Style x:Key="Shotwise.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="Shotwise.TopBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style x:Key="Shotwise.BottomBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="Shotwise.SidePanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Width" Value="312" />
    </Style>
    <Style x:Key="Shotwise.SegmentedNav" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style x:Key="Shotwise.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style x:Key="Shotwise.VDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
        <Setter Property="Margin" Value="6,12" />
    </Style>
    <Style x:Key="Shotwise.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
    </Style>
    <Style x:Key="Shotwise.AccentChip" TargetType="Border" BasedOn="{StaticResource Shotwise.Chip}">
        <Setter Property="Background" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
    </Style>
    <Style x:Key="Shotwise.Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Shotwise.AccentBrush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="10.5" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Shotwise.OnAccentBrush}" />
    </Style>

    <!-- ===================================================================== Buttons (keyed; icon via sw:SwUi.Icon) -->
    <Style x:Key="Shotwise.ButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding (sw:SwUi.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <sw:SwIcon x:Name="Icon" Source="{Binding (sw:SwUi.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       Size="{Binding (sw:SwUi.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="sw:SwUi.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                            <Setter TargetName="Cp" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Shotwise.PrimaryButton" TargetType="ButtonBase" BasedOn="{StaticResource Shotwise.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Shotwise.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shotwise.SecondaryButton" TargetType="ButtonBase" BasedOn="{StaticResource Shotwise.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shotwise.GhostButton" TargetType="ButtonBase" BasedOn="{StaticResource Shotwise.ButtonBase}">
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shotwise.DangerButton" TargetType="ButtonBase" BasedOn="{StaticResource Shotwise.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Shotwise.DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.DangerHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Toggle variant of the ghost button (checked = accent subtle) e.g. Effects | Properties panel toggles -->
    <Style x:Key="Shotwise.GhostToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource Shotwise.ButtonBase}">
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 32 px round icon-only button (set sw:SwUi.Icon + AutomationProperties.Name + ToolTip) -->
    <Style x:Key="Shotwise.IconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
        <Setter Property="sw:SwUi.IconSize" Value="18" />
        <Setter Property="sw:SwUi.CornerRadius" Value="999" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual.Round}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{Binding (sw:SwUi.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid>
                            <sw:SwIcon Source="{Binding (sw:SwUi.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                       Size="{Binding (sw:SwUi.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Command button with the ToolButton look (Undo / Redo / More): icon (sw:SwUi.Icon) above an 11 px caption -->
    <Style x:Key="Shotwise.ToolCommandButton" TargetType="ButtonBase">
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="sw:SwUi.IconSize" Value="22" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Height="24">
                                <sw:SwIcon Source="{Binding (sw:SwUi.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                           Size="{Binding (sw:SwUi.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter Margin="0,3,0,0" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== ToolButton -->
    <Style TargetType="sw:ToolButton">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:ToolButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <sw:SwIcon Source="{TemplateBinding Icon}" Size="{TemplateBinding IconSize}" HorizontalAlignment="Center" />
                            <ContentPresenter Margin="0,3,0,0" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentSubtleHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== CaptureButton -->
    <Style TargetType="sw:CaptureButton">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:CaptureButton">
                    <StackPanel Background="Transparent">
                        <Grid x:Name="Disc" Width="{TemplateBinding Diameter}" Height="{TemplateBinding Diameter}" Margin="10,10,10,0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse x:Name="Halo" Margin="-9" Fill="{DynamicResource Shotwise.CaptureRingBrush}" />
                            <Ellipse x:Name="Glow" Fill="{DynamicResource Shotwise.CaptureSolidBrush}" Effect="{DynamicResource Shotwise.Elevation.CaptureGlow}" Opacity="0.6" />
                            <Ellipse x:Name="Face" Fill="{DynamicResource Shotwise.CaptureBrush}" />
                            <Ellipse Margin="2">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#40FFFFFF" />
                                        <GradientStop Offset="0.5" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="FocusRing" Margin="-6" Stroke="{DynamicResource Shotwise.AccentBrush}" StrokeThickness="2.5" Visibility="Collapsed" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <sw:SwIcon x:Name="Icon" Source="{TemplateBinding Icon}" Size="26" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="Caption" Text="{TemplateBinding Shortcut}" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Shotwise.TextSecondaryBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Shortcut" Value="{x:Null}">
                            <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Fill" Value="{DynamicResource Shotwise.CaptureHoverBrush}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Fill" Value="{DynamicResource Shotwise.CapturePressedBrush}" />
                            <Setter TargetName="Disc" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- accent ring for keyboard navigation only (Tab / arrows); mouse and window activation keep just the coral glow -->
                        <Trigger Property="ShowFocusRing" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== SplitButton -->
    <Style x:Key="Shotwise.SplitChevron" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,6,6,0">
                        <sw:SwIcon Source="{DynamicResource Icon.ChevronDown.Filled}" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="sw:SplitButton">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{DynamicResource Shotwise.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.OnAccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:SplitButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <sw:SwIcon x:Name="Icon" Source="{TemplateBinding Icon}" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Margin="0,7" Background="#47FFFFFF" />
                            <ToggleButton x:Name="PART_DropDown" Grid.Column="2" Width="30" Style="{StaticResource Shotwise.SplitChevron}"
                                          ToolTip="{TemplateBinding DropDownToolTip}" AutomationProperties.Name="{TemplateBinding DropDownToolTip}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Shotwise.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Shotwise.AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== NavItem: segmented (default), mode rail, list -->
    <Style TargetType="sw:NavItem">
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:NavItem">
                    <Grid>
                        <Border x:Name="Lift" CornerRadius="8" Background="{DynamicResource Shotwise.Surface1Brush}" Effect="{DynamicResource Shotwise.Elevation.Raised}" Visibility="Collapsed" />
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center">
                                    <sw:SwIcon x:Name="Icon" Source="{TemplateBinding Icon}" Size="{TemplateBinding IconSize}" />
                                    <Ellipse x:Name="Dot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                                             Fill="{DynamicResource Shotwise.CaptureSolidBrush}" Stroke="{DynamicResource Shotwise.Surface1Brush}" StrokeThickness="1.5" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Margin="0,2,0,0" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Lift" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shotwise.ModeRailItem" TargetType="sw:NavItem">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="66" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="IconSize" Value="28" />
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:NavItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="1.5" BorderBrush="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Center">
                                <sw:SwIcon Source="{TemplateBinding Icon}" Size="{TemplateBinding IconSize}" />
                                <Ellipse x:Name="Dot" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                                         Fill="{DynamicResource Shotwise.CaptureSolidBrush}" Stroke="{DynamicResource Shotwise.Surface1Brush}" StrokeThickness="1.5" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="0,4,0,0" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Shotwise.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shotwise.NavListItem" TargetType="sw:NavItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="IconSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:NavItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Shotwise.AccentBrush}" Visibility="Hidden" />
                            <sw:SwIcon x:Name="Icon" Grid.Column="1" Source="{TemplateBinding Icon}" Size="{TemplateBinding IconSize}" Margin="9,0,10,0" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Border x:Name="BadgeBd" Grid.Column="3" Margin="8,0,10,0" Style="{StaticResource Shotwise.Chip}" Padding="7,1">
                                <ContentPresenter Content="{TemplateBinding Badge}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="BadgeBd" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Margin" Value="9,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BadgeBd" Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
                            <Setter TargetName="BadgeBd" Property="TextElement.Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Shotwise.AccentTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Switch + ToggleSwitchRow -->
    <Style x:Key="Shotwise.Switch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="20" Background="Transparent" VerticalAlignment="Center">
                        <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource Shotwise.SwitchOffTrackBrush}" />
                        <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0"
                                 Fill="{DynamicResource Shotwise.SwitchKnobBrush}" Effect="{DynamicResource Shotwise.Elevation.Raised}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Shotwise.AccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="16" />
                            <Setter TargetName="Knob" Property="Height" Value="16" />
                            <Setter TargetName="Knob" Property="Margin" Value="2,0,0,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Shotwise.AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="sw:ToggleSwitchRow">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:ToggleSwitchRow">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <sw:SwIcon x:Name="Icon" Source="{TemplateBinding Icon}" Size="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter RecognizesAccessKey="True" />
                                <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" FontSize="11.5" Margin="0,1,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Shotwise.TextSecondaryBrush}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Trailing}" Margin="12,0,10,0" VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="3" Style="{StaticResource Shotwise.Switch}" Focusable="False" IsHitTestVisible="False"
                                          IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Card / PanelHeader / PropertyRow -->
    <Style TargetType="sw:Card">
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:Card">
                    <Grid>
                        <Border x:Name="Shadow" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Effect="{DynamicResource Shotwise.Elevation.Card}" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Elevation" Value="0">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Elevation" Value="2">
                            <Setter TargetName="Shadow" Property="Effect" Value="{DynamicResource Shotwise.Elevation.Flyout}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Shotwise.ChevronToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual.Round}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12">
                        <sw:SwIcon x:Name="Chevron" Source="{DynamicResource Icon.ChevronDown.Regular}" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <sw:SwIcon.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </sw:SwIcon.RenderTransform>
                        </sw:SwIcon>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="sw:PanelHeader">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8,8,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:PanelHeader">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}" VerticalAlignment="Center" TextElement.FontWeight="Normal" />
                            <Button x:Name="Help" Grid.Column="2" Style="{StaticResource Shotwise.IconButton}" Width="26" Height="26" Margin="4,0,0,0"
                                    sw:SwUi.Icon="{DynamicResource Icon.Help.Regular}" sw:SwUi.IconSize="16"
                                    ToolTip="{TemplateBinding HelpText}" AutomationProperties.Name="Help" Command="{x:Static sw:PanelHeader.HelpCommand}" />
                            <ToggleButton x:Name="Collapse" Grid.Column="3" Style="{StaticResource Shotwise.ChevronToggle}" Margin="4,0,0,0" AutomationProperties.Name="Expand or collapse"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HelpText" Value="{x:Null}">
                            <Setter TargetName="Help" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CanCollapse" Value="True">
                            <Setter TargetName="Collapse" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="sw:PropertyRow">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:PropertyRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding Label}" Width="{TemplateBinding LabelWidth}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Shotwise.TextSecondaryBrush}" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <ContentPresenter x:Name="Trail" Grid.Column="2" Content="{TemplateBinding Trailing}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Trailing" Value="{x:Null}">
                            <Setter TargetName="Trail" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Inputs: number box, search box, slider -->
    <Style x:Key="Shotwise.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderStrongBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Shotwise.AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <sw:SwIcon x:Name="Icon" Source="{Binding (sw:SwUi.Icon), RelativeSource={RelativeSource TemplatedParent}}" Size="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Shotwise.TextTertiaryBrush}" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Shotwise.TextTertiaryBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="sw:SwUi.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Shotwise.TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Shotwise.AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shotwise.NumberBox" TargetType="TextBox" BasedOn="{StaticResource Shotwise.TextBox}">
        <Setter Property="Width" Value="52" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Search box: set Tag = placeholder text; icon defaults to Icon.Search.Regular -->
    <Style x:Key="Shotwise.SearchBox" TargetType="TextBox" BasedOn="{StaticResource Shotwise.TextBox}">
        <Setter Property="sw:SwUi.Icon" Value="{DynamicResource Icon.Search.Regular}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="Shotwise.SliderRepeatFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2,0,0,2" Background="{DynamicResource Shotwise.AccentBrush}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shotwise.SliderRepeatEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shotwise.SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18" Background="Transparent">
                        <Ellipse Fill="{DynamicResource Shotwise.Surface1Brush}" Stroke="{DynamicResource Shotwise.BorderStrongBrush}" StrokeThickness="1" Effect="{DynamicResource Shotwise.Elevation.Raised}" />
                        <Ellipse x:Name="Core" Width="8" Height="8" Fill="{DynamicResource Shotwise.AccentBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Core" Property="Width" Value="10" />
                            <Setter TargetName="Core" Property="Height" Value="10" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Core" Property="Width" Value="7" />
                            <Setter TargetName="Core" Property="Height" Value="7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shotwise.Slider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid MinHeight="24" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Shotwise.Surface3Brush}" VerticalAlignment="Center" Margin="2,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Shotwise.SliderRepeatFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Shotwise.SliderRepeatEmpty}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Shotwise.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="sw:SliderWithValue">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:SliderWithValue">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Lbl" Text="{TemplateBinding Label}" Width="{TemplateBinding LabelWidth}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Shotwise.TextSecondaryBrush}" />
                        <Slider Grid.Column="1" Style="{StaticResource Shotwise.Slider}" VerticalAlignment="Center"
                                Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                SmallChange="{TemplateBinding SmallChange}" LargeChange="{TemplateBinding LargeChange}"
                                TickFrequency="{TemplateBinding TickFrequency}" IsSnapToTickEnabled="{TemplateBinding IsSnapToTickEnabled}"
                                AutomationProperties.Name="{TemplateBinding Label}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <TextBox x:Name="PART_Box" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Shotwise.NumberBox}" VerticalAlignment="Center" />
                        <!-- unit column keeps its width when empty so stacked rows align -->
                        <TextBlock x:Name="UnitText" Grid.Column="3" Text="{TemplateBinding Unit}" Margin="4,0,0,0" MinWidth="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Shotwise.TextTertiaryBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="Lbl" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== ColorSwatchButton + ColorPicker swatch cells -->
    <Style x:Key="Shotwise.SwatchCell" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="Edge" CornerRadius="3" Width="18" Height="18" BorderThickness="1" BorderBrush="#26000000" />
                        <Border x:Name="Ring" CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource Shotwise.AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="sw:ColorSwatchButton">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderStrongBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:ColorSwatchButton">
                    <StackPanel Background="Transparent">
                        <TextBlock x:Name="Lbl" Text="{TemplateBinding Label}" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5" HorizontalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="{TemplateBinding SwatchSize}" Height="{TemplateBinding SwatchSize}" CornerRadius="5" Padding="1">
                                    <Border CornerRadius="4" Background="{x:Static sw:ColorSwatchButton.Checker}" />
                                </Border>
                                <Border Width="{TemplateBinding SwatchSize}" Height="{TemplateBinding SwatchSize}" CornerRadius="5" Background="{TemplateBinding SwatchBrush}"
                                        BorderBrush="#1F000000" BorderThickness="1" />
                                <sw:SwIcon Grid.Column="1" Source="{DynamicResource Icon.ChevronDown.Filled}" Size="12" Margin="4,0,1,0" VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource Shotwise.TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="Lbl" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Shotwise.TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Shotwise.Surface3Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== ShadowDirectionPicker -->
    <Style x:Key="Shotwise.ShadowCell" TargetType="ToggleButton">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Shotwise.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="sw:ShadowDirectionPicker">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Shotwise.TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:ShadowDirectionPicker">
                    <StackPanel>
                        <Border Background="{DynamicResource Shotwise.Surface1Brush}" BorderBrush="{DynamicResource Shotwise.BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Center">
                            <UniformGrid x:Name="PART_Grid" Rows="3" Columns="3" />
                        </Border>
                        <ToggleButton x:Name="PART_None" Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Shotwise.GhostToggleButton}"
                                      MinHeight="22" Padding="6,0" FontSize="11" sw:SwUi.Icon="{DynamicResource Icon.Dismiss.Regular}" sw:SwUi.IconSize="12" Content="No shadow" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Preview templates for StylePreviewComboBox -->
    <!-- item: double (line width in px) -->
    <DataTemplate x:Key="Shotwise.PreviewTemplate.LineWidth">
        <Grid Width="64" Height="18">
            <Border Height="{Binding}" MaxHeight="16" MinHeight="1" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Shotwise.TextPrimaryBrush}" />
        </Grid>
    </DataTemplate>
    <!-- item: DoubleCollection (dash pattern in stroke widths) -->
    <DataTemplate x:Key="Shotwise.PreviewTemplate.DashArray">
        <Grid Width="64" Height="18">
            <Line X1="1" X2="63" Y1="9" Y2="9" StrokeThickness="3" StrokeDashArray="{Binding}" Stroke="{DynamicResource Shotwise.TextPrimaryBrush}" />
        </Grid>
    </DataTemplate>
    <!-- item: Geometry (e.g. an arrow cap shape) -->
    <DataTemplate x:Key="Shotwise.PreviewTemplate.Geometry">
        <Path Width="28" Height="12" Stretch="Uniform" Data="{Binding}" Fill="{DynamicResource Shotwise.TextPrimaryBrush}" />
    </DataTemplate>
    <!-- item: ImageSource (rendered preview) -->
    <DataTemplate x:Key="Shotwise.PreviewTemplate.Image">
        <Image Width="56" Height="18" Stretch="Uniform" Source="{Binding}" />
    </DataTemplate>

    <!-- ===================================================================== Tiles: QuickStyleTile, TrayItem + their lists -->
    <Style TargetType="sw:QuickStyleTile">
        <Setter Property="IsSelected" Value="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, FallbackValue=False}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:QuickStyleTile">
                    <Grid Width="{TemplateBinding TileSize}" Height="{TemplateBinding TileSize}">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Shotwise.Surface1Brush}" BorderBrush="{DynamicResource Shotwise.BorderSubtleBrush}" BorderThickness="1">
                            <Image Source="{TemplateBinding Thumbnail}" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Shotwise.AccentBrush}" Visibility="Collapsed" />
                        <sw:SwIcon x:Name="Star" Source="{DynamicResource Icon.Tool.Favorites.Color}" Size="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFavorite" Value="True">
                            <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Shotwise.BorderStrongBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Shotwise.Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="sw:TrayItem">
        <Setter Property="IsSelected" Value="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, FallbackValue=False}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:TrayItem">
                    <Grid Width="{TemplateBinding ItemWidth}" Height="{TemplateBinding ItemHeight}">
                        <Border x:Name="Ring" Margin="-4" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource Shotwise.AccentBrush}" Visibility="Collapsed" />
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Shotwise.Surface2Brush}" BorderBrush="{DynamicResource Shotwise.BorderSubtleBrush}" BorderThickness="1">
                            <Border CornerRadius="7">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Border>
                        <Ellipse x:Name="Modified" Width="8" Height="8" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Fill="{DynamicResource Shotwise.WarningBrush}" Stroke="White" StrokeThickness="1" Visibility="Collapsed" />
                        <Border x:Name="Pin" Width="20" Height="20" CornerRadius="10" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{DynamicResource Shotwise.AccentBrush}" Visibility="Collapsed">
                            <sw:SwIcon Source="{DynamicResource Icon.Pin.Filled}" Size="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Dur" CornerRadius="4" Padding="4,1,6,1" Margin="0,0,5,5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#B3101116">
                            <StackPanel Orientation="Horizontal">
                                <sw:SwIcon Source="{DynamicResource Icon.Play.Filled}" Size="10" Foreground="White" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBlock Text="{TemplateBinding Duration}" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Duration" Value="{x:Null}">
                            <Setter TargetName="Dur" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPinned" Value="True">
                            <Setter TargetName="Pin" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsModified" Value="True">
                            <Setter TargetName="Modified" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Shotwise.TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Container for tile/tray lists: no chrome, keyboard focus ring, selection shown by the tile itself -->
    <Style x:Key="Shotwise.TileListItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shotwise.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shotwise.TileList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Shotwise.TileListItem}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Shotwise.TrayList" TargetType="ListBox" BasedOn="{StaticResource Shotwise.TileList}">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Shotwise.TileListItem}">
                    <Setter Property="Margin" Value="6,6" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== InfoBar / Toast / EmptyState -->
    <ControlTemplate x:Key="Shotwise.InfoBarTemplate" TargetType="sw:InfoBar">
        <Grid>
            <Border x:Name="Shadow" Background="{TemplateBinding Background}" CornerRadius="10" Effect="{DynamicResource Shotwise.Elevation.Flyout}" Visibility="Collapsed" />
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <sw:SwIcon x:Name="Icon" Source="{DynamicResource Icon.Info.Filled}" Size="20" Margin="0,0,12,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource Shotwise.AccentBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Shotwise.TextPrimaryBrush}" />
                        <TextBlock x:Name="MessageText" Text="{TemplateBinding Message}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource Shotwise.TextSecondaryBrush}" />
                        <ContentPresenter />
                    </StackPanel>
                    <ContentPresenter Grid.Column="2" Content="{TemplateBinding Action}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Button x:Name="Close" Grid.Column="3" Style="{StaticResource Shotwise.IconButton}" Width="28" Height="28" Margin="8,-4,-4,-4" VerticalAlignment="Top"
                            sw:SwUi.Icon="{DynamicResource Icon.Dismiss.Regular}" sw:SwUi.IconSize="14" AutomationProperties.Name="Close" ToolTip="Close"
                            Command="{x:Static sw:InfoBar.CloseCommand}" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
                <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Message" Value="{x:Null}">
                <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsClosable" Value="False">
                <Setter TargetName="Close" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Severity" Value="Success">
                <Setter TargetName="Icon" Property="Source" Value="{DynamicResource Icon.Success.Color}" />
            </Trigger>
            <Trigger Property="Severity" Value="Warning">
                <Setter TargetName="Icon" Property="Source" Value="{DynamicResource Icon.Warning.Color}" />
            </Trigger>
            <Trigger Property="Severity" Value="Error">
                <Setter TargetName="Icon" Property="Source" Value="{DynamicResource Icon.Error.Color}" />
            </Trigger>
            <Trigger Property="Tag" Value="Toast">
                <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="sw:InfoBar">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Shotwise.InfoSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.AccentSubtleBrush}" />
        <Setter Property="Template" Value="{StaticResource Shotwise.InfoBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Severity" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Shotwise.SuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
            </Trigger>
            <Trigger Property="Severity" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Shotwise.WarningSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
            </Trigger>
            <Trigger Property="Severity" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Shotwise.DangerSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Floating toast: Surface1 + flyout elevation (severity shown by the icon) -->
    <Style x:Key="Shotwise.Toast" TargetType="sw:InfoBar">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Tag" Value="Toast" />
        <Setter Property="Background" Value="{DynamicResource Shotwise.Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shotwise.BorderSubtleBrush}" />
        <Setter Property="Template" Value="{StaticResource Shotwise.InfoBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="sw:EmptyState">
        <Setter Property="FontFamily" Value="{DynamicResource Shotwise.FontFamily}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sw:EmptyState">
                    <StackPanel MaxWidth="360" Margin="24">
                        <Grid Width="104" Height="104" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Shotwise.AccentSubtleBrush}" />
                            <Ellipse Margin="14" Fill="{DynamicResource Shotwise.Surface1Brush}" Effect="{DynamicResource Shotwise.Elevation.Card}" />
                            <sw:SwIcon Source="{TemplateBinding Illustration}" Size="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Shotwise.AccentBrush}" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Title}" Margin="0,18,0,6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Shotwise.TextPrimaryBrush}" />
                        <TextBlock Text="{TemplateBinding Description}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{DynamicResource Shotwise.TextSecondaryBrush}" />
                        <ContentPresenter Content="{TemplateBinding Action}" Margin="0,18,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
