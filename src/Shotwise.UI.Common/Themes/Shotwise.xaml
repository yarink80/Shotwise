<!-- The Shotwise design system in one dictionary: tokens (Light by default; ShotwiseTheme / ThemeService swap them at runtime),
     metrics, icons and component styles. Merged by Resources/SharedResources.xaml, so every app that merges SharedResources gets it.
     Merge AFTER the WPF-UI ThemesDictionary + ControlsDictionary. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Shotwise.UI.Common;component/Themes/Tokens.Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Shotwise.UI.Common;component/Themes/Metrics.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Shotwise.UI.Common;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Shotwise.UI.Common;component/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
