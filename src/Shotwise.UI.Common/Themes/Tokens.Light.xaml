<!-- Shotwise design tokens - LIGHT theme (docs/DESIGN-SYSTEM.md section 2). Swapped at runtime by ShotwiseTheme / ThemeService.
     Every key here MUST also exist in Tokens.Dark.xaml (and ShotwiseTheme.HighContrast). Reference with {DynamicResource ...}. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Shotwise.ThemeName">Light</sys:String>

    <!-- Brand / accent -->
    <Color x:Key="Shotwise.Color.Accent">#5B4CF5</Color>
    <Color x:Key="Shotwise.Color.AccentHover">#4A3BE0</Color>
    <Color x:Key="Shotwise.Color.AccentPressed">#3C2FC7</Color>
    <Color x:Key="Shotwise.Color.AccentText">#4A3BE0</Color>
    <Color x:Key="Shotwise.Color.AccentSubtle">#1F5B4CF5</Color>
    <Color x:Key="Shotwise.Color.AccentSubtleHover">#2E5B4CF5</Color>
    <Color x:Key="Shotwise.Color.OnAccent">#FFFFFF</Color>

    <!-- Capture / record (coral) -->
    <Color x:Key="Shotwise.Color.Capture">#FF4D5E</Color>
    <Color x:Key="Shotwise.Color.CaptureEnd">#FF7A45</Color>
    <Color x:Key="Shotwise.Color.CaptureGlow">#66FF5A52</Color>

    <!-- Status -->
    <Color x:Key="Shotwise.Color.Success">#16A34A</Color>
    <Color x:Key="Shotwise.Color.Warning">#F59E0B</Color>
    <Color x:Key="Shotwise.Color.Danger">#E11D48</Color>
    <Color x:Key="Shotwise.Color.Info">#5B4CF5</Color>

    <!-- Surfaces -->
    <Color x:Key="Shotwise.Color.Surface0">#F6F7FB</Color>
    <Color x:Key="Shotwise.Color.Surface1">#FFFFFF</Color>
    <Color x:Key="Shotwise.Color.Surface2">#EEF0F7</Color>
    <Color x:Key="Shotwise.Color.Surface3">#E3E6F0</Color>
    <Color x:Key="Shotwise.Color.Canvas">#E9EBF2</Color>
    <Color x:Key="Shotwise.Color.BorderSubtle">#E3E5EE</Color>
    <Color x:Key="Shotwise.Color.BorderStrong">#CDD1DE</Color>
    <Color x:Key="Shotwise.Color.TextPrimary">#14151A</Color>
    <Color x:Key="Shotwise.Color.TextSecondary">#5A5F73</Color>
    <Color x:Key="Shotwise.Color.TextTertiary">#8A8FA3</Color>
    <Color x:Key="Shotwise.Color.TextDisabled">#B2B6C4</Color>
    <Color x:Key="Shotwise.Color.Shadow">#1A1D2B</Color>

    <!-- Brushes: accent -->
    <SolidColorBrush x:Key="Shotwise.AccentBrush" Color="#5B4CF5" />
    <SolidColorBrush x:Key="Shotwise.AccentHoverBrush" Color="#4A3BE0" />
    <SolidColorBrush x:Key="Shotwise.AccentPressedBrush" Color="#3C2FC7" />
    <SolidColorBrush x:Key="Shotwise.AccentTextBrush" Color="#4A3BE0" />
    <SolidColorBrush x:Key="Shotwise.AccentSubtleBrush" Color="#1F5B4CF5" />
    <SolidColorBrush x:Key="Shotwise.AccentSubtleHoverBrush" Color="#2E5B4CF5" />
    <SolidColorBrush x:Key="Shotwise.OnAccentBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="Shotwise.AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#7A6CFF" />
        <GradientStop Offset="1" Color="#4F3FEA" />
    </LinearGradientBrush>

    <!-- Brushes: capture -->
    <SolidColorBrush x:Key="Shotwise.CaptureSolidBrush" Color="#FF4D5E" />
    <LinearGradientBrush x:Key="Shotwise.CaptureBrush" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Offset="0" Color="#FF7A45" />
        <GradientStop Offset="1" Color="#FF4D5E" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Shotwise.CaptureHoverBrush" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Offset="0" Color="#FF8A57" />
        <GradientStop Offset="1" Color="#FF5A69" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Shotwise.CapturePressedBrush" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Offset="0" Color="#F06A38" />
        <GradientStop Offset="1" Color="#E83E50" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Shotwise.CaptureRingBrush" Color="#24FF5A52" />

    <!-- Brushes: status (fill, subtle background, text-on-surface) -->
    <SolidColorBrush x:Key="Shotwise.SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="Shotwise.SuccessSubtleBrush" Color="#EAF7EF" />
    <SolidColorBrush x:Key="Shotwise.SuccessTextBrush" Color="#11803A" />
    <SolidColorBrush x:Key="Shotwise.WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="Shotwise.WarningSubtleBrush" Color="#FEF6E4" />
    <SolidColorBrush x:Key="Shotwise.WarningTextBrush" Color="#A15C07" />
    <SolidColorBrush x:Key="Shotwise.DangerBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="Shotwise.DangerHoverBrush" Color="#C8163E" />
    <SolidColorBrush x:Key="Shotwise.DangerSubtleBrush" Color="#FDECF0" />
    <SolidColorBrush x:Key="Shotwise.DangerTextBrush" Color="#BE123C" />
    <SolidColorBrush x:Key="Shotwise.InfoSubtleBrush" Color="#EFEDFE" />

    <!-- Brushes: surfaces / borders / text -->
    <SolidColorBrush x:Key="Shotwise.Surface0Brush" Color="#F6F7FB" />
    <SolidColorBrush x:Key="Shotwise.Surface1Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Shotwise.Surface2Brush" Color="#EEF0F7" />
    <SolidColorBrush x:Key="Shotwise.Surface3Brush" Color="#E3E6F0" />
    <SolidColorBrush x:Key="Shotwise.CanvasBrush" Color="#E9EBF2" />
    <SolidColorBrush x:Key="Shotwise.BorderSubtleBrush" Color="#E3E5EE" />
    <SolidColorBrush x:Key="Shotwise.BorderStrongBrush" Color="#CDD1DE" />
    <SolidColorBrush x:Key="Shotwise.TextPrimaryBrush" Color="#14151A" />
    <SolidColorBrush x:Key="Shotwise.TextSecondaryBrush" Color="#5A5F73" />
    <SolidColorBrush x:Key="Shotwise.TextTertiaryBrush" Color="#8A8FA3" />
    <SolidColorBrush x:Key="Shotwise.TextDisabledBrush" Color="#B2B6C4" />
    <SolidColorBrush x:Key="Shotwise.ScrimBrush" Color="#66101118" />
    <SolidColorBrush x:Key="Shotwise.HudBrush" Color="#E61B1C22" />
    <SolidColorBrush x:Key="Shotwise.HudTextBrush" Color="#F3F4F8" />
    <SolidColorBrush x:Key="Shotwise.SwitchOffTrackBrush" Color="#C9CDDA" />
    <SolidColorBrush x:Key="Shotwise.SwitchKnobBrush" Color="#FFFFFF" />

    <!-- Elevation (DropShadowEffect; apply to a shadow layer BEHIND content, never to a text container) -->
    <DropShadowEffect x:Key="Shotwise.Elevation.Card" Color="#1A1D2B" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.08" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shotwise.Elevation.Raised" Color="#1A1D2B" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.12" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shotwise.Elevation.Flyout" Color="#1A1D2B" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.16" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shotwise.Elevation.CaptureGlow" Color="#FF5A52" BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.45" RenderingBias="Performance" />
</ResourceDictionary>
