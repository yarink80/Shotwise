<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF shared library: theme, resources (Strings.resx), converters, common controls, IDialogService contract, DialogWindow base. -->
  <PropertyGroup>
    <TargetFramework>$(ShotwiseTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotwiseSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Shotwise.UI.Common</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shotwise.Core\Shotwise.Core.csproj" />
  </ItemGroup>

  <!-- App icon (generated by tools/icon-gen into src/Shotwise.App/Assets): window icons, title-bar mark, tray icons (Theming/AppIcon.cs). -->
  <ItemGroup>
    <Resource Include="..\Shotwise.App\Assets\shotwise.ico" Link="Assets\shotwise.ico" />
    <Resource Include="..\Shotwise.App\Assets\shotwise-tray.ico" Link="Assets\shotwise-tray.ico" />
    <Resource Include="..\Shotwise.App\Assets\shotwise-tray-recording.ico" Link="Assets\shotwise-tray-recording.ico" />
  </ItemGroup>

  <!--
    Strongly typed resource class (Shotwise.UI.Common.Resources.Strings) generated from Resources\Strings.resx at build time,
    before the WPF markup pre-compile, so XAML ({x:Static res:Strings.Key}) and code can use it. No VS custom tool needed:
    just add <data> entries to Strings.resx.
  -->
  <PropertyGroup>
    <ShotwiseStringsClassFile>$(IntermediateOutputPath)Strings.Designer.g.cs</ShotwiseStringsClassFile>
  </PropertyGroup>

  <!-- Skipped inside the WPF temporary markup project (*_wpftmp), which already receives the generated file via @(Compile). -->
  <Target Name="ShotwiseGenerateStringsClass" BeforeTargets="MarkupCompilePass1;CoreCompile" Inputs="Resources\Strings.resx" Outputs="$(ShotwiseStringsClassFile)"
          Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <GenerateResource Sources="Resources\Strings.resx"
                      OutputResources="$(IntermediateOutputPath)Strings.typed.resources"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="Shotwise.UI.Common.Resources"
                      StronglyTypedClassName="Strings"
                      StronglyTypedManifestPrefix="Shotwise.UI.Common.Resources"
                      StronglyTypedFileName="$(ShotwiseStringsClassFile)"
                      PublicClass="true"
                      ExecuteAsTool="false" />
  </Target>

  <Target Name="ShotwiseIncludeStringsClass" AfterTargets="ShotwiseGenerateStringsClass" BeforeTargets="MarkupCompilePass1;CoreCompile"
          Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ItemGroup>
      <Compile Remove="$(ShotwiseStringsClassFile)" />
      <Compile Include="$(ShotwiseStringsClassFile)" />
      <FileWrites Include="$(ShotwiseStringsClassFile);$(IntermediateOutputPath)Strings.typed.resources" />
    </ItemGroup>
  </Target>

</Project>
