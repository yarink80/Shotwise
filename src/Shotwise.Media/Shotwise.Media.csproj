<Project Sdk="Microsoft.NET.Sdk">

  <!-- Video probe/frames/edit render/combine, GIF encoder/decoder, video-from-images engine. Owner: WP-MEDIA. -->
  <PropertyGroup>
    <TargetFramework>$(ShotwiseTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotwiseSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Shotwise.Media</RootNamespace>
    <!-- WPF framework reference only for GifBitmapDecoder (WIC); no XAML UI here. -->
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Vortice.MediaFoundation" />
    <PackageReference Include="Vortice.Direct3D11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shotwise.Core\Shotwise.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shotwise.Media.Tests" />
  </ItemGroup>

</Project>
