<Project Sdk="Microsoft.NET.Sdk">

  <!-- Skia renderer, annotation painters, effects, image codecs (Skia + WIC), PDF export. Owner: WP-RENDERING. -->
  <PropertyGroup>
    <TargetFramework>$(ShotwiseTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotwiseSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <RootNamespace>Shotwise.Rendering</RootNamespace>
    <!-- WPF framework reference is needed only for WIC codecs (System.Windows.Media.Imaging); no XAML UI here. -->
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="PDFsharp" />
    <!-- Security pin for PDFsharp's transitive dependency (see Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shotwise.Core\Shotwise.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shotwise.Rendering.Tests" />
  </ItemGroup>

</Project>
