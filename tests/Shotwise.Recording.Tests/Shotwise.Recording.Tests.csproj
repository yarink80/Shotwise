<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hosts WP-RECORDING's opt-in manual harness ([Fact(Skip=...)]) plus unit tests. -->
  <PropertyGroup>
    <TargetFramework>$(ShotwiseTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotwiseSupportedOSPlatformVersion)</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shotwise.Core\Shotwise.Core.csproj" />
    <ProjectReference Include="..\..\src\Shotwise.Recording\Shotwise.Recording.csproj" />
    <!-- Media's IVideoService decodes and tags recorder output in tests (MED-06, playable partial recordings). -->
    <ProjectReference Include="..\..\src\Shotwise.Media\Shotwise.Media.csproj" />
  </ItemGroup>

</Project>
