<Project>
  <!--
    Central Package Management for the whole Shotwise solution.
    New packages need a licence check (MIT, Apache-2.0 or BSD) and an entry in THIRD-PARTY-NOTICES.md.
    Versions are the latest stable releases that still ship assets compatible with net8.0 / net8.0-windows
    (resolved 2026-10-17). Where the newest line dropped net8.0 (SkiaSharp.Views.WPF 4.x, H.NotifyIcon.Wpf 2.4,
    NAudio 3.x) the last compatible stable line is pinned instead.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Hosting / DI / Logging">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup Label="Rendering">
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="3.119.2" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="3.119.2" />
    <PackageVersion Include="Svg.Skia" Version="5.1.1" />
    <!-- 6.2.4 = last MIT-licensed release; 6.5.0+ is AGPL-3.0-only (incompatible with our licensing). Do not bump. -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- Security pin: PDFsharp pulls System.Security.Cryptography.Pkcs 8.0.1 (CVE-2026-84008, CVE-2026-70162 — DoS); 8.0.2 is the patched 8.x release. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Label="Win32 / DirectX / Media Foundation / Audio">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.363" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageVersion Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageVersion Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageVersion Include="NAudio" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup Label="Vision / ML">
    <PackageVersion Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <ItemGroup Label="Library">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Sharing">
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.91.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.0" />
    <!-- No Microsoft.Graph, Google, Dropbox or Box SDKs: Shotwise.Sharing calls those services through their documented
         REST APIs over HttpClient. -->
    <PackageVersion Include="FluentFTP" Version="55.1.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="MimeKit" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <PackageVersion Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup Label="Packaging">
    <!-- Velopack (MIT): per-user installer + install/update/uninstall hooks. Keep in lock-step with the `vpk` dotnet tool
         version used by tools/package.ps1 ($VpkVersion). Published 2026-09-29. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
