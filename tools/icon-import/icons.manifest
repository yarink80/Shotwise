# Shotwise icon manifest (input of tools/icon-import).
# Format:  Key | fluent-icon-name | variants
#   r            -> Icon.<Key>.Regular  (Geometry, 20 px design scaled to a 24-unit box)
#   f            -> Icon.<Key>.Filled   (Geometry, 24 px design)
#   c[:name]     -> Icon.<Key>.Color    (DrawingImage, Fluent "Color" icon <name or fluent-icon-name>_24_color, gradients kept)
#   t:#top,#bottom -> Icon.<Key>.Color  (DrawingImage, the Filled 24 px glyph painted with a Shotwise hue gradient)
# Hues for the t: variants are Shotwise's own palette (docs/DESIGN-SYSTEM.md "Tool hues").

# ---- Editor tools (every tool gets Regular + Filled + Color) ----
Tool.Select      | cursor          | r f t:#B9BED0,#5A5F73
Tool.Move        | arrow_move      | r f t:#A3ABBE,#4B5468
Tool.Arrow       | arrow_up_left   | r f t:#FF9466,#EE3B2B
Tool.Line        | line            | r f t:#FFC27A,#F26B0F
Tool.Shape       | shapes          | r f t:#5EE08A,#139A45
Tool.Callout     | comment         | r f c
Tool.Text        | text_t          | r f t:#6FB4FF,#2160E8
Tool.Stamp       | sticker         | r f t:#FF8CC8,#D9206F
Tool.Step        | number_circle_1 | r f t:#B9A2FF,#7434E6
Tool.Pen         | pen             | r f t:#FFD84D,#E09A00
Tool.Highlighter | highlight       | r f t:#FFE866,#EFAE00
Tool.Fill        | paint_bucket    | r f t:#FFB46B,#E8590C
Tool.Eraser      | eraser          | r f t:#FF9DB2,#DE1D4B
Tool.Magnify     | zoom_in         | r f t:#7FD6FF,#0A84CC
Tool.Blur        | blur            | r f t:#86D9E4,#2F8295
Tool.Crop        | crop            | r f t:#40E2C6,#0C8A7D
Tool.CutOut      | cut             | r f t:#FFD257,#D27A05
Tool.Selection   | select_object   | r f t:#9097FF,#4C43E0
Tool.MagicWand   | wand            | r f t:#F08DFF,#A11BB0
Tool.Simplify    | shape_union     | r f t:#B8E85A,#4B8A0E
Tool.GrabText    | scan_type       | r f c
Tool.Cursor      | cursor_click    | r f t:#CFD7E3,#5F6F86
Tool.Favorites   | star            | r f c

